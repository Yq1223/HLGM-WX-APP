.page-mine {
  padding-bottom: 20rpx;
}

/* ========== 用户头部 ========== */
.user-header {
  background: linear-gradient(135deg, #FF6B35, #FF8C5A);
  padding: 40rpx 32rpx 32rpx;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  margin-right: 24rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.2);
}

.avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-detail {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFF;
  margin-bottom: 8rpx;
}

.user-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  border-radius: 16rpx;
}

.user-tag.admin {
  background: rgba(255, 215, 0, 0.3);
  color: #FFD700;
  border: 1rpx solid rgba(255, 215, 0, 0.5);
}

.user-tag.normal {
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.8);
}

.login-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ========== 积分卡片 ========== */
.points-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 24rpx;
}

.points-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
}

.points-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #FFF;
}

.points-link {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* ========== 管理员专属区域 ========== */
.admin-section {
  background: #FFF;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.admin-header {
  padding: 20rpx 24rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.admin-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.admin-subscribe-btn {
  font-size: 22rpx;
  color: #FF6B35;
  background: rgba(255, 107, 53, 0.1);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

.admin-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 12rpx 20rpx;
}

.admin-grid-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}

.grid-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.grid-text {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

.grid-desc {
  font-size: 20rpx;
  color: #BBB;
  margin-top: 4rpx;
}

/* ========== 功能入口 ========== */
.func-card {
  background: #FFF;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.func-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.func-item:last-child {
  border-bottom: none;
}

.func-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.func-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.func-desc {
  font-size: 22rpx;
  color: #CCC;
  margin-right: 12rpx;
}

.func-arrow {
  font-size: 28rpx;
  color: #CCC;
}

/* ========== 区块标题 ========== */
.section-header {
  padding: 24rpx 32rpx 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* ========== Tab栏 ========== */
.tab-bar {
  display: flex;
  padding: 16rpx 24rpx;
  background: #FFF;
  margin: 16rpx 24rpx;
  border-radius: 12rpx;
  gap: 8rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #666;
  padding: 12rpx 0;
  border-radius: 8rpx;
}

.tab-item.active {
  background: #FF6B35;
  color: #FFF;
  font-weight: 600;
}

/* ========== 列表卡片 ========== */
.my-card {
  background: #FFF;
  margin: 12rpx 24rpx;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.my-card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.my-card-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-right: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.my-card-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #BBB;
}

/* ========== 登录弹窗 ========== */
.login-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-card {
  width: 85%;
  background: #FFF;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  text-align: center;
}

.login-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}

.login-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

/* 头像选择 */
.login-avatar-wrap {
  margin-bottom: 32rpx;
}

.login-avatar-btn {
  background: none;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-avatar-btn::after {
  border: none;
}

.login-avatar-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid #FF6B35;
  margin-bottom: 12rpx;
}

.login-avatar-hint {
  font-size: 24rpx;
  color: #FF6B35;
}

/* 昵称输入 */
.login-nickname-wrap {
  margin-bottom: 40rpx;
}

.login-nickname-input {
  border: 2rpx solid #EEE;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  height: 80rpx;
  text-align: center;
}

/* 确认按钮 */
.login-confirm-btn {
  background: linear-gradient(135deg, #FF6B35, #FF8C5A);
  color: #FFF;
  border: none;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.3);
}

.login-confirm-btn::after {
  border: none;
}

/* ========== 加载动画 ========== */
.loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid #EEE;
  border-top-color: #FF6B35;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
