.page-detail {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

/* 反馈信息卡片 */
.info-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.info-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 16rpx;
}

.tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.tag-pending {
  background: #FFF3E0;
  color: #FF9800;
}

.tag-progress {
  background: #E3F2FD;
  color: #2196F3;
}

.tag-done {
  background: #E8F5E9;
  color: #4CAF50;
}

.info-meta {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.info-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 管理员回复卡片 */
.reply-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.reply-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.reply-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.reply-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.reply-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
}

/* 管理员操作区 */
.admin-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.status-options {
  display: flex;
  margin-bottom: 30rpx;
}

.status-option {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #666;
}

.status-option:last-child {
  margin-right: 0;
}

.status-option.active {
  border-color: #FF6B35;
  color: #FF6B35;
  background: #FFF3E0;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.status-dot.pending {
  background: #FF9800;
}

.status-dot.progress {
  background: #2196F3;
}

.status-dot.done {
  background: #4CAF50;
}

.reply-input-wrap {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.reply-textarea {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  min-height: 160rpx;
  width: 100%;
  box-sizing: border-box;
}

.audit-btn {
  background: linear-gradient(135deg, #FF6B35, #FF8C42);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
}

.audit-btn::after {
  border: none;
}

.audit-btn[disabled] {
  background: #ccc;
}
