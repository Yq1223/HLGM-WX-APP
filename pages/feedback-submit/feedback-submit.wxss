.page-submit {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.form-input {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.form-textarea {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  min-height: 240rpx;
  width: 100%;
  box-sizing: border-box;
}

.word-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.tip-card {
  background: #FFF8E1;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
}

.tip-title {
  font-size: 28rpx;
  color: #F57C00;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #795548;
  line-height: 1.8;
}

.btn-wrap {
  padding: 20rpx 0;
}

.submit-btn {
  background: linear-gradient(135deg, #FF6B35, #FF8C42);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #ccc;
}
