/* 开屏页 */
.splash-page {
  min-height: 100vh;
  background: linear-gradient(160deg, #FF6B35 0%, #FF8C5A 30%, #FFB088 60%, #FFF5EE 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

/* 背景装饰圆 */
.bg-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.1;
  background: #FFF;
}
.bg-circle-1 {
  width: 400rpx;
  height: 400rpx;
  top: -100rpx;
  right: -80rpx;
}
.bg-circle-2 {
  width: 300rpx;
  height: 300rpx;
  bottom: 200rpx;
  left: -100rpx;
}
.bg-circle-3 {
  width: 200rpx;
  height: 200rpx;
  top: 300rpx;
  right: 100rpx;
}

/* 主内容 */
.splash-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
}

/* Logo */
.logo-wrap {
  margin-bottom: 40rpx;
}

.logo-img {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
}

/* 应用名 */
.app-name {
  text-align: center;
  margin-bottom: 48rpx;
}

.name-cn {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  color: #FFF;
  letter-spacing: 8rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.name-en {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 6rpx;
  margin-top: 8rpx;
  text-transform: uppercase;
}

/* Slogan */
.slogan {
  margin-bottom: 80rpx;
  padding: 0 60rpx;
}

.slogan-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-style: italic;
  letter-spacing: 2rpx;
}

/* 进入按钮 */
.enter-wrap {
  margin-bottom: 60rpx;
}

.enter-btn {
  background: #FFF;
  color: #FF6B35;
  border: none;
  border-radius: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 64rpx;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.enter-btn::after {
  border: none;
}

.enter-arrow {
  font-size: 28rpx;
}

/* 底部 */
.splash-footer {
  position: absolute;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 10;
}

.footer-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 动画 */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(30rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-fade-in {
  animation: fadeIn 0.8s ease-out forwards;
}

.animate-fade-in-delay1 {
  opacity: 0;
  animation: fadeIn 0.8s ease-out 0.2s forwards;
}

.animate-fade-in-delay2 {
  opacity: 0;
  animation: fadeIn 0.8s ease-out 0.4s forwards;
}

.animate-fade-in-delay3 {
  opacity: 0;
  animation: fadeIn 0.8s ease-out 0.6s forwards;
}
