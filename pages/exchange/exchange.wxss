.page-exchange {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
}

.coming-soon {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
}

.coming-anim {
  font-size: 160rpx;
  margin-bottom: 32rpx;
  animation: bounce 2s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.coming-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.coming-subtitle {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.coming-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.btn-notify {
  background: #FF6B35;
  color: #FFF;
  border: none;
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
  width: 400rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 106, 0, 0.2);
}

.btn-notify::after {
  border: none;
}

.notify-hint {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #52C41A;
}
