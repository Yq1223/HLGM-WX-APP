<view class="page-exchange">
  <!-- 会员列表 -->
  <view class="exchange-section" wx:for="{{categories}}" wx:key="name">
    <view class="section-title">
      <image class="section-logo" src="/images/vip/{{item.logo}}" mode="aspectFit" />
      <text class="section-name">{{item.name}}</text>
      <view class="coming-soon-tag">即将上线</view>
    </view>
    <view class="goods-list">
      <view class="goods-card" wx:for="{{item.goods}}" wx:for-item="goods" wx:key="name">
        <view class="goods-icon" style="background:{{item.color}};">
          <text class="goods-icon-text">{{goods.icon}}</text>
        </view>
        <view class="goods-info">
          <view class="goods-name">{{goods.name}}</view>
          <view class="goods-hint" style="color:{{item.color}};">{{goods.hint}}</view>
        </view>
        <view class="goods-price">
          <text class="price-waiting">敬请期待</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部提示 -->
  <view class="exchange-footer">
    <view class="footer-tip">💡 发布优质信息可获得积分</view>
    <view class="footer-tip">📢 开放兑换后将第一时间通知您</view>
  </view>
</view>
