.page-publish {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* ========== 批量导入横幅 ========== */
.import-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 20rpx 24rpx;
  padding: 24rpx 28rpx;
  background: #FFF9F3;
  border-radius: 12rpx;
  border: 1rpx solid #FFE8D4;
}

.import-left {
  display: flex;
  align-items: center;
}

.import-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}

.import-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #FF6B35;
}

.import-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.import-arrow {
  font-size: 28rpx;
  color: #CCCCCC;
}

/* ========== 导入结果弹窗 ========== */
.import-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.import-result-card {
  width: 80%;
  background: #FFF;
  border-radius: 12rpx;
  overflow: hidden;
}

.result-header {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  padding: 28rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.result-body {
  padding: 32rpx;
}

.result-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.result-icon {
  margin-right: 12rpx;
}

.result-num {
  font-weight: 700;
  color: #FF6B35;
}

.result-row.fail .result-num {
  color: #FF4D4F;
}

.result-detail {
  margin-top: 20rpx;
  padding: 16rpx;
  background: #FFF9F3;
  border-radius: 44rpx;
  max-height: 300rpx;
  overflow-y: auto;
}

.detail-item {
  font-size: 24rpx;
  color: #FF4D4F;
  padding: 6rpx 0;
  border-bottom: 1rpx solid #F5F0EA;
}

.detail-item:last-child {
  border-bottom: none;
}

.result-btn {
  margin: 0 32rpx 32rpx;
  background: #FF6B35;
  color: #FFF;
  border: none;
  border-radius: 44rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
}

.result-btn::after {
  border: none;
}

/* ========== 表单 ========== */
.form-card {
  background: #FFF;
  margin: 20rpx 24rpx;
  border-radius: 12rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.form-item {
  margin-bottom: 32rpx;
  position: relative;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.required {
  color: #FF4D4F;
}

.form-input {
  border: 2rpx solid #F0F0F0;
  border-radius: 6rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  height: 80rpx;
}

.form-textarea {
  border: 2rpx solid #F0F0F0;
  border-radius: 6rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  height: 240rpx;
  box-sizing: border-box;
}

.char-count {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  font-size: 22rpx;
  color: #CCCCCC;
}

/* 分类选择 */
.category-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  padding: 10rpx 28rpx;
  border-radius: 6rpx;
  font-size: 26rpx;
  background: #F5F5F5;
  color: #666;
  border: 2rpx solid transparent;
}

.category-item.active {
  background: #FFF4EC;
  color: #FF6B35;
  border-color: #FF6B35;
}

/* ========== 提交按钮 ========== */
.submit-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  background: #FFF;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.04);
  z-index: 100;
}

.submit-btn {
  margin: 0;
}
