.page-index {
  padding-bottom: 20rpx;
}

/* 整体 sticky 头部 */
.sticky-header {
  position: sticky;
  top: 0;
  z-index: 100;
}

/* 搜索栏 */
.search-bar {
  background: linear-gradient(135deg, #FF6B35, #FF8C5A);
  padding: 16rpx 24rpx 24rpx;
}

.brand-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.brand-info {
  display: flex;
  align-items: center;
}

.brand-logo {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  margin-right: 16rpx;
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFF;
}

.brand-slogan {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 2rpx;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #FFF;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 72rpx;
}

.search-placeholder {
  color: #CCC;
}

.search-clear {
  font-size: 28rpx;
  color: #999;
  padding: 10rpx;
}

/* 分类筛选 */
.category-bar {
  background: #FFF;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.category-scroll {
  display: flex;
  padding: 0 24rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.category-scroll::-webkit-scrollbar {
  display: none;
}

.category-tag {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #F5F5F5;
  flex-shrink: 0;
}

.category-tag.active {
  background: #FF6B35;
  color: #FFF;
}

/* 羊毛卡片 */
.wool-card {
  background: #FFF;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  position: relative;
}

/* 上新角标 */
.new-badge {
  position: absolute;
  top: 0;
  left: 0;
  background: linear-gradient(135deg, #FF4D4F, #FF7875);
  color: #FFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 16rpx 4rpx 8rpx;
  border-radius: 0 0 16rpx 0;
  z-index: 2;
}

.card-body {
  padding: 24rpx;
}

/* 商品卡片布局 */
.card-product {
  display: flex;
  margin-bottom: 16rpx;
}

.card-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #F5F5F5;
}

.card-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}

/* 标签行 */
.card-tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.discount-tag {
  background: #FFF0F0;
  color: #FF4D4F;
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.coupon-mini-tag {
  background: #FFF3E8;
  color: #FF6B35;
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

/* 额外信息 */
.card-extra {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.extra-sales {
  font-size: 20rpx;
  color: #999;
}

/* 非商品卡片 */
.card-content {
  margin-bottom: 12rpx;
}

.card-summary {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
  border-top: 1rpx solid #F5F5F5;
}

.meta-left {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #999;
}

.meta-dot {
  margin: 0 8rpx;
}

.meta-views {
  font-size: 22rpx;
  color: #BBB;
}

/* 加载动画 */
.loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid #EEE;
  border-top-color: #FF6B35;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
