.page-admin {
  padding-bottom: 20rpx;
}

/* 顶部操作栏 */
.admin-top-bar {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 24rpx 0;
  background: #FFF;
}

.subscribe-btn {
  font-size: 24rpx;
  color: #FF6B35;
  background: rgba(255, 107, 53, 0.1);
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  background: #FFF;
  padding: 16rpx 24rpx;
  gap: 12rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.filter-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #666;
  padding: 12rpx 0;
  border-radius: 16rpx;
  background: #F5F5F5;
}

.filter-item.active {
  background: #FF6B35;
  color: #FFF;
  font-weight: 600;
}

/* 卡片 */
.admin-card {
  background: #FFF;
  margin: 16rpx 24rpx;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.admin-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.admin-card-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-right: 16rpx;
}

.admin-card-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.admin-card-summary {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
  padding: 12rpx;
  background: #FAFAFA;
  border-radius: 8rpx;
}

.admin-card-reject {
  font-size: 24rpx;
  margin-bottom: 12rpx;
  padding: 10rpx 14rpx;
  background: #FFF2F0;
  border-radius: 6rpx;
}

.reject-label {
  color: #FF4D4F;
  font-weight: 500;
}

.reject-text {
  color: #666;
}

.admin-card-actions {
  display: flex;
  gap: 16rpx;
  border-top: 1rpx solid #F0F0F0;
  padding-top: 16rpx;
}

.action-btn {
  flex: 1;
  font-size: 24rpx;
  padding: 0;
  margin: 0;
  height: 56rpx;
  line-height: 52rpx;
  border-radius: 16rpx;
  background: #FFF;
  border: 2rpx solid #EEE;
}

.action-btn::after {
  border: none;
}

.action-pass {
  color: #52C41A;
  border-color: #52C41A;
}

.action-reject {
  color: #FF4D4F;
  border-color: #FF4D4F;
}

.action-offline {
  color: #FAAD14;
  border-color: #FAAD14;
}

.action-online {
  color: #52C41A;
  border-color: #52C41A;
}

.action-delete {
  flex: 0 0 80rpx;
  color: #FF4D4F;
  border-color: #FF4D4F;
}

/* 加载 */
.loading-spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid #EEE;
  border-top-color: #FF6B35;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
