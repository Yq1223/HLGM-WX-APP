.page-detail {
  padding-bottom: env(safe-area-inset-bottom);
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
  color: #999;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #EEE;
  border-top-color: #FF6B35;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 状态栏 */
.status-bar {
  padding: 16rpx 32rpx;
  background: #FFFBE6;
}

.reject-reason {
  display: block;
  font-size: 24rpx;
  color: #FF4D4F;
}

/* 内容卡片 */
.content-card {
  background: #FFF;
  margin: 20rpx 24rpx;
  border-radius: 12rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  position: relative;
}

.detail-new-tag {
  display: inline-block;
  background: linear-gradient(135deg, #FF4D4F, #FF7875);
  color: #FFF;
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.info-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.info-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.meta-dot {
  margin: 0 8rpx;
}

.info-category {
  margin-bottom: 16rpx;
}

/* 商品图片 */
.detail-image-wrap {
  margin-bottom: 24rpx;
  position: relative;
}

.detail-image {
  width: 100%;
  border-radius: 12rpx;
  max-height: 500rpx;
}

.image-tap-hint {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #FFF;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

/* 价格对比 */
.price-compare {
  background: #FFF9F0;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.price-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.price-block {
  text-align: center;
}

.price-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.price-now .price-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #FF4D4F;
}

.price-orig .price-value {
  font-size: 32rpx;
  color: #BBB;
  text-decoration: line-through;
}

.price-arrow {
  margin: 0 24rpx;
  padding-top: 24rpx;
}

.arrow-icon {
  font-size: 32rpx;
  color: #FF6B35;
}

.price-save {
  margin-left: auto;
  background: #FF4D4F;
  color: #FFF;
  font-size: 24rpx;
  font-weight: 700;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

.coupon-row {
  display: flex;
  align-items: center;
}

.coupon-badge {
  background: #FF6B35;
  color: #FFF;
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}

.coupon-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: #FF6B35;
}

/* 商品额外信息 */
.product-extra {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.extra-item {
  font-size: 22rpx;
  color: #666;
  background: #F5F5F5;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.info-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  word-break: break-all;
}

.info-steps {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #FFF9F0;
  border-radius: 12rpx;
  border-left: 6rpx solid #FF6B35;
}

.steps-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.steps-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 复制链接购买 */
.buy-action {
  margin-top: 24rpx;
  text-align: center;
}

.btn-copy-buy {
  background: linear-gradient(135deg, #FF6B35, #FF8C5A);
  color: #FFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  border: none;
}

.btn-copy-buy::after {
  border: none;
}

.buy-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}

/* 操作栏 */
.action-bar {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  background: #FFF;
  margin: 20rpx 24rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.btn-danger {
  background: #FFF;
  color: #FF4D4F;
  border: 2rpx solid #FF4D4F;
  border-radius: 28rpx;
  height: 56rpx;
  line-height: 52rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
}

.btn-danger::after {
  border: none;
}
