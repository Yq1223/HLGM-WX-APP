<view class="page-detail">
  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>

  <block wx:if="{{!loading && info}}">
    <!-- 状态标签 -->
    <view class="status-bar" wx:if="{{info.status !== 1}}">
      <view class="tag tag-{{info.status === 0 ? 'pending' : info.status === 2 ? 'rejected' : 'offline'}}">
        {{info.statusDesc}}
      </view>
      <text class="reject-reason" wx:if="{{info.status === 2 && info.rejectReason}}">
        驳回理由：{{info.rejectReason}}
      </text>
    </view>

    <!-- 内容区域 -->
    <view class="content-card">
      <!-- 上新标签 -->
      <view class="detail-new-tag" wx:if="{{info.isNew}}">上新</view>

      <view class="info-title">{{info.title}}</view>
      <view class="info-meta">
        <text class="meta-author">{{info.authorName || '匿名'}}</text>
        <text class="meta-dot">·</text>
        <text class="meta-time">{{info.createdAt}}</text>
        <text class="meta-dot">·</text>
        <text class="meta-views">👁 {{info.viewCount || 0}}</text>
      </view>
      <view class="info-category" wx:if="{{info.category}}">
        <text class="tag tag-online">{{info.category}}</text>
      </view>
      <view class="divider"></view>

      <!-- 商品类内容 -->
      <block wx:if="{{info.product.isProduct}}">
        <!-- 商品图片（可点击大图） -->
        <view class="detail-image-wrap" wx:if="{{info.product.imageUrl}}" bindtap="previewImage">
          <image class="detail-image" src="{{info.product.imageUrl}}" mode="widthFix" />
          <view class="image-tap-hint">点击查看大图</view>
        </view>

        <!-- 价格对比 -->
        <view class="price-compare">
          <view class="price-row">
            <view class="price-block price-now">
              <text class="price-label">到手价</text>
              <text class="price-value">¥{{info.product.finalPrice}}</text>
            </view>
            <view class="price-arrow">
              <text class="arrow-icon">→</text>
            </view>
            <view class="price-block price-orig">
              <text class="price-label">原价</text>
              <text class="price-value">¥{{info.product.originalPrice}}</text>
            </view>
            <view class="price-save" wx:if="{{info.product.discount > 0}}">
              <text class="save-text">省{{info.product.discount}}%</text>
            </view>
          </view>
          <view class="coupon-row" wx:if="{{info.product.couponAmount > 0}}">
            <view class="coupon-badge">优惠券</view>
            <text class="coupon-amount">¥{{info.product.couponAmount}}</text>
          </view>
        </view>

        <!-- 商品额外信息 -->
        <view class="product-extra">
          <text class="extra-item" wx:if="{{info.product.salesTip}}">📊 {{info.product.salesTip}}</text>
          <text class="extra-item" wx:if="{{info.product.remainQuantity > 0}}">📦 剩余 {{info.product.remainQuantity}} 件</text>
          <text class="extra-item" wx:if="{{info.product.shopName}}">🏪 {{info.product.shopName}}</text>
          <text class="extra-item" wx:if="{{info.product.brandName}}">🏷️ {{info.product.brandName}}</text>
        </view>
      </block>

      <!-- 非商品类内容 -->
      <block wx:else>
        <view class="info-content">
          <rich-text nodes="{{info.textContent}}"></rich-text>
        </view>
      </block>

      <!-- 领取步骤 -->
      <view class="info-steps" wx:if="{{info.displayClaimSteps}}">
        <view class="steps-title">📋 领取步骤</view>
        <view class="steps-content">{{info.displayClaimSteps}}</view>
      </view>

      <!-- 复制链接去购买 -->
      <view class="buy-action" wx:if="{{info.sourceUrl}}">
        <button class="btn-copy-buy" bindtap="openSource">📋 复制链接去购买</button>
        <text class="buy-hint">复制链接后打开浏览器或对应App粘贴访问</text>
      </view>
    </view>

    <!-- 广告位：详情页底部（预留） -->
    <ad-banner position="detail_bottom" />

    <!-- 操作按钮 - 发布者本人 -->
    <view class="action-bar" wx:if="{{isOwner}}">
      <button class="btn-secondary btn-sm" bindtap="onEdit">✏️ 编辑</button>
      <button class="btn-danger btn-sm" bindtap="onDelete">🗑️ 删除</button>
    </view>

    <!-- 操作按钮 - 管理员 -->
    <view class="action-bar" wx:if="{{isAdmin && !isOwner}}">
      <block wx:if="{{info.status === 0}}">
        <button class="btn-primary btn-sm" bindtap="onAuditPass">✅ 通过</button>
        <button class="btn-danger btn-sm" bindtap="onAuditReject">❌ 驳回</button>
      </block>
      <block wx:if="{{info.status === 1}}">
        <button class="btn-secondary btn-sm" bindtap="onToggleOnline" data-online="false">⬇️ 下线</button>
      </block>
      <block wx:if="{{info.status === 3 || info.status === 2}}">
        <button class="btn-primary btn-sm" bindtap="onToggleOnline" data-online="true">⬆️ 上线</button>
      </block>
      <button class="btn-danger btn-sm" bindtap="onAdminDelete">🗑️ 删除</button>
    </view>
  </block>
</view>
