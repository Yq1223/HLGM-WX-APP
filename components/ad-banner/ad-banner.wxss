.ad-wrap {
  margin: 16rpx 24rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.ad-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F8F8F8;
  border: 2rpx dashed #E0E0E0;
  border-radius: 12rpx;
  height: 120rpx;
  position: relative;
}

.ad-tag {
  position: absolute;
  top: 4rpx;
  right: 8rpx;
  font-size: 18rpx;
  color: #CCC;
}

.ad-text {
  font-size: 24rpx;
  color: #CCC;
}

/* 不同位置的尺寸 */
.ad-index_top .ad-placeholder {
  height: 120rpx;
}

.ad-index_between .ad-placeholder {
  height: 160rpx;
}

.ad-detail_bottom .ad-placeholder {
  height: 100rpx;
}

.ad-mine_banner .ad-placeholder {
  height: 140rpx;
}

.ad-points_banner .ad-placeholder {
  height: 100rpx;
}
