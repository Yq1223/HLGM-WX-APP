.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}
.empty-emoji {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
.empty-title {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 40rpx;
  text-align: center;
}
.empty-btn {
  background: #FF6B35;
  color: #FFF;
  padding: 16rpx 48rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
}
